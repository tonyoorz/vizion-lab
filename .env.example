# Local trusted single-user deployment only. Never expose internal mode on a LAN.
VIZION_AGENT_AUTH_MODE=internal
VIZION_INTERNAL_TEAM_IDS=DTSV_China
VIZION_INTERNAL_ROW_POLICY_IDS=agent.operations.read

# Deploy GLMProxy separately. Match its INCOMING_API_KEY; never use a VITE_ prefix.
GLM_PROXY_BASE_URL=http://127.0.0.1:8001/v1
GLM_PROXY_API_KEY=

# Obtain the enterprise CA through an approved channel and use a native file path.
# UPSTREAM_CA_BUNDLE=/absolute/native/path/BBA_ROOT_CA_1.pem

SESSION_KEEPER_URL=http://127.0.0.1:18090

# Restore user-level ModelScope caches or configure a native model directory.
DUPSEARCH_TRANSCRIBE_PROVIDER=local-funasr
DUPSEARCH_LOCAL_ASR_DEVICE=cpu
# DUPSEARCH_LOCAL_ASR_MODEL=/absolute/native/path/SenseVoiceSmall